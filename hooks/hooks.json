{
  "description": "android-cleanup-agent safety guards: raw adb changes outside the CLI, fastboot, root and inline-code escapes, human-only gates for clearing app data and restarting, and edits of the tool's own state",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash-guard.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/write-guard.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
